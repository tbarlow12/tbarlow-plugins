#!/usr/bin/env python3
"""
fleet-build: Generate an iTerm2 arrangement from fleet.yaml.

Usage: fleet-build [path/to/fleet.yaml]

Reads fleet.yaml, builds a cols×rows tiled arrangement with one pane per
agent per repo, and writes an .iterm2arrangement file ready to import.

Each repo gets its own tab. Within each tab, panes are assigned to agent
directories in row-major order:
  agents 1,2,3   (top row)
  agents 4,5,6   (bottom row)  — for a 3×2 layout
"""
import sys
import os
import plistlib
import uuid

import _fleet_yaml
import _fleet_iterm
from _fleet_colors import parse_color, rgb_dict, DEFAULT_TAB_PALETTE

# ---------------------------------------------------------------------------
# plist helpers
# ---------------------------------------------------------------------------

def new_guid():
    return str(uuid.uuid4()).upper()

def minimal_session_view(working_dir, profile, frame, badge=None, tab_name=None, tab_color=None,
                          profile_dict=None, point_size=13.0, badge_color=None):
    """Build a SessionView plist dict, starting from a full copy of the real
    profile's settings so the pane inherits everything (colors, cursor,
    scrollback, fonts, bell behavior, ...) instead of falling back to
    iTerm's from-scratch defaults for the handful of settings someone
    thought to hand-copy. Only the keys that must differ per-session are
    overridden after the copy.

    Guid is intentionally re-generated (not the real profile's own Guid) —
    linking it makes iTerm treat the session as "launch this saved profile
    fresh," which discards the per-session overrides below (Working
    Directory, Tab Color, Columns/Rows) in favor of the profile's own
    stored values.
    """
    guid = new_guid()
    # char cell size approximated from the real profile's font point size,
    # so Columns/Rows render at a normal, readable size instead of the tiny
    # fallback font iTerm uses for an unlinked bookmark with no font set.
    char_w = point_size * 0.6
    char_h = point_size * 1.25
    bm = dict(profile_dict) if profile_dict else {}
    bm.update({
        'Working Directory': working_dir,
        'Custom Directory': 'Yes',  # force Working Directory above to be honored regardless of the source profile's own directory setting
        'Guid': new_guid(),
        'Original Guid': new_guid(),
        'Name': tab_name or profile,
        'Columns': max(20, int(frame['width'] / char_w)),
        'Rows': max(6, int(frame['height'] / char_h)),
    })
    if badge:
        bm['Badge Text'] = badge
        if badge_color:
            # iTerm2 prefers the light/dark-mode-specific variants over the
            # plain key when the app is in dark mode, so all three must be
            # set or the profile's inherited (Dark) variant wins.
            bm['Badge Color'] = badge_color
            bm['Badge Color (Dark)'] = badge_color
            bm['Badge Color (Light)'] = badge_color
    if tab_color:
        bm['Tab Color'] = tab_color
        bm['Use Tab Color'] = True

    sv = {
        'View Type': 'SessionView',
        'frame': {k: float(v) for k, v in frame.items()},
        'Is Active': 0,
        'Session': {
            'Session GUID': guid,
            'Working Directory': working_dir,
            'Last Directory': working_dir,
            'Last Local Directory': working_dir,
            'TTY': '',
            'Commands': [],
            'Directories': [],
            'Hosts': [],
            'Bookmark': bm,
            'Variables': {
                'path': working_dir,
                'id': guid,
                'termid': f'w0t0p0.{guid}',
                **(({'autoName': tab_name, 'autoNameFormat': tab_name,
                     'name': f'{tab_name} (-zsh)',
                     'presentationName': f'{tab_name} (-zsh)',
                     'profileName': tab_name}) if tab_name else {}),
                **(({'badge': badge}) if badge else {}),
            },
        },
    }
    return sv

def make_col_splitter(subviews, frame):
    return {
        'Splitter ID': new_guid(),
        'Subviews': subviews,
        'View Type': 'Splitter',
        'frame': {k: float(v) for k, v in frame.items()},
        'isVertical': False,
    }

def make_root_splitter(col_splitters, frame):
    return {
        'Splitter ID': new_guid(),
        'Subviews': col_splitters,
        'View Type': 'Splitter',
        'frame': {k: float(v) for k, v in frame.items()},
        'isVertical': True,
    }

def set_active_pane(root):
    """Activate the top-left pane."""
    try:
        root['Subviews'][0]['Subviews'][0]['Is Active'] = 1
    except (KeyError, IndexError, TypeError):
        pass

# ---------------------------------------------------------------------------
# Tab builder
# ---------------------------------------------------------------------------

def build_tab(repo_name, cfg, color, agent_offset=0):
    """
    Build one tab for repo_name.
    agent_offset: first agent number (always 1 here; kept for extensibility).
    Panes assigned in row-major order across cols×rows.
    """
    W = cfg['width']
    H = cfg['height']
    cols = cfg['cols']
    rows = cfg['rows']
    col_w = W / cols

    # Distribute height evenly; last row absorbs remainder
    row_heights = []
    remaining = H
    for r in range(rows):
        h = round(H / rows) if r < rows - 1 else remaining
        row_heights.append(h)
        remaining -= h + 1  # 1px divider

    col_splitters = []

    for c in range(cols):
        x = col_w * c
        panes = []
        y = 0.0
        for r in range(rows):
            agent_num = agent_offset + r * cols + c + 1
            working_dir = os.path.join(cfg['base_dir'], str(agent_num), repo_name)
            h = row_heights[r]
            sv = minimal_session_view(
                working_dir=working_dir,
                profile=cfg['profile'],
                frame={'height': h, 'width': col_w, 'x': 0.0, 'y': y},
                badge=f'{repo_name}-{agent_num}',
                tab_name=repo_name,
                tab_color=color,
                profile_dict=cfg['profile_dict'],
                point_size=cfg['point_size'],
                badge_color=cfg['badge_color_rgb'],
            )
            panes.append(sv)
            y += h + 1
        col_splitters.append(make_col_splitter(
            panes,
            {'height': H, 'width': col_w, 'x': x, 'y': 0.0},
        ))

    root = make_root_splitter(col_splitters, {'height': H, 'width': W, 'x': 0.0, 'y': 0.0})
    set_active_pane(root)
    return {'Root': root, 'Tab GUID': new_guid()}


def build_path_tab(path, tab_name, cfg, color):
    """
    Build one tab for a non-repo path. All panes open the same directory.
    The path is shared across agents — no per-agent subdirectory.
    """
    W = cfg['width']
    H = cfg['height']
    cols = cfg['cols']
    rows = cfg['rows']
    col_w = W / cols

    row_heights = []
    remaining = H
    for r in range(rows):
        h = round(H / rows) if r < rows - 1 else remaining
        row_heights.append(h)
        remaining -= h + 1

    col_splitters = []

    for c in range(cols):
        x = col_w * c
        panes = []
        y = 0.0
        for r in range(rows):
            pane_num = r * cols + c + 1
            h = row_heights[r]
            sv = minimal_session_view(
                working_dir=path,
                profile=cfg['profile'],
                frame={'height': h, 'width': col_w, 'x': 0.0, 'y': y},
                badge=f'{tab_name}-{pane_num}',
                tab_name=tab_name,
                tab_color=color,
                profile_dict=cfg['profile_dict'],
                point_size=cfg['point_size'],
                badge_color=cfg['badge_color_rgb'],
            )
            panes.append(sv)
            y += h + 1
        col_splitters.append(make_col_splitter(
            panes,
            {'height': H, 'width': col_w, 'x': x, 'y': 0.0},
        ))

    root = make_root_splitter(col_splitters, {'height': H, 'width': W, 'x': 0.0, 'y': 0.0})
    set_active_pane(root)
    return {'Root': root, 'Tab GUID': new_guid()}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    config_path = sys.argv[1] if len(sys.argv) > 1 else _fleet_yaml.DEFAULT_PATH

    try:
        cfg = _fleet_yaml.load(config_path)
    except FileNotFoundError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    profile_dict = _fleet_iterm.get_profile_dict(cfg['profile'])
    cfg['profile_dict'] = profile_dict
    font = (profile_dict or {}).get('Normal Font', 'Menlo 13')
    cfg['point_size'] = float(font.rsplit(' ', 1)[-1])

    badge_spec = cfg.get('badge_color') or 'gray'
    r, g, b = parse_color(badge_spec)
    cfg['badge_color_rgb'] = rgb_dict(r, g, b, alpha=0.5)

    palette_specs = cfg.get('tab_colors') or DEFAULT_TAB_PALETTE
    tab_palette = [rgb_dict(*parse_color(spec)) for spec in palette_specs]

    repo_names = [os.path.basename(u.rstrip('/').removesuffix('.git')) for u in cfg['repos']]
    extra_paths = [(os.path.expanduser(p), os.path.basename(p.rstrip('/'))) for p in cfg.get('paths') or []]

    total_tabs = len(repo_names) + len(extra_paths)
    print(f"Building arrangement: {len(repo_names)} repos + {len(extra_paths)} paths × {cfg['agent_count']} agents "
          f"({cfg['cols']}×{cfg['rows']} layout)")

    tabs = []
    for i, repo_name in enumerate(repo_names):
        color = tab_palette[i % len(tab_palette)]
        tab = build_tab(repo_name, cfg, color)
        tabs.append(tab)
        print(f"  + {repo_name}")

    for j, (path, tab_name) in enumerate(extra_paths):
        color = tab_palette[(len(repo_names) + j) % len(tab_palette)]
        tab = build_path_tab(path, tab_name, cfg, color)
        tabs.append(tab)
        print(f"  + {tab_name} (path: {path})")

    window = {
        'Tabs': tabs,
        'Window Type': 15,  # WINDOW_TYPE_MAXIMIZED — fills the screen, stays a normal window (no separate Space)
    }

    out_path = cfg['arrangement_path']
    os.makedirs(os.path.dirname(out_path), exist_ok=True)

    with open(out_path, 'wb') as f:
        plistlib.dump([window], f, fmt=plistlib.FMT_XML)

    print(f"\nWritten to {out_path}")
    print("Run fleet-open to import into iTerm2.")

if __name__ == '__main__':
    main()
