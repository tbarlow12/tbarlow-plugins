#!/usr/bin/env python3
"""
fleet-remove-path: Remove a non-repo path from fleet.yaml.

Usage: fleet-remove-path <path-or-name> [path/to/fleet.yaml]

<path-or-name> can be the full path or just the directory basename.
"""
import sys
import os

import _fleet_yaml


def path_name(p):
    return os.path.basename(os.path.expanduser(p).rstrip('/'))


def main():
    if len(sys.argv) < 2:
        print("Usage: fleet-remove-path <path-or-name> [path/to/fleet.yaml]", file=sys.stderr)
        sys.exit(1)
    target = sys.argv[1]
    config_path = sys.argv[2] if len(sys.argv) > 2 else _fleet_yaml.DEFAULT_PATH

    try:
        cfg = _fleet_yaml.load(config_path)
    except FileNotFoundError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    target_name = path_name(target)
    paths = cfg.get('paths') or []
    remaining = [p for p in paths if path_name(p) != target_name]
    if len(remaining) == len(paths):
        print(f"ERROR: no path named '{target_name}' found in {config_path}", file=sys.stderr)
        sys.exit(1)

    cfg['paths'] = remaining
    _fleet_yaml.save(cfg)
    print(f"Removed path '{target_name}' from {config_path}")
    print("Next: fleet-apply")


if __name__ == '__main__':
    main()
