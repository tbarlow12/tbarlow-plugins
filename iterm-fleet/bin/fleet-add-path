#!/usr/bin/env python3
"""
fleet-add-path: Add a non-repo path to fleet.yaml.

Each path gets its own tab in the arrangement. All panes in that tab open
the same directory (it is not cloned per-agent like repos are).

Usage: fleet-add-path <path> [path/to/fleet.yaml]
"""
import sys
import os

import _fleet_yaml


def main():
    if len(sys.argv) < 2:
        print("Usage: fleet-add-path <path> [path/to/fleet.yaml]", file=sys.stderr)
        sys.exit(1)
    raw = sys.argv[1]
    config_path = sys.argv[2] if len(sys.argv) > 2 else _fleet_yaml.DEFAULT_PATH

    expanded = os.path.expanduser(raw)
    if not os.path.isdir(expanded):
        print(f"ERROR: '{expanded}' is not an existing directory", file=sys.stderr)
        sys.exit(1)

    try:
        cfg = _fleet_yaml.load(config_path)
    except FileNotFoundError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    existing = {os.path.expanduser(p) for p in cfg.get('paths') or []}
    if expanded in existing:
        print(f"'{expanded}' is already in {config_path}")
        sys.exit(0)

    cfg.setdefault('paths', []).append(raw)
    _fleet_yaml.save(cfg)
    tab_name = os.path.basename(expanded.rstrip('/'))
    print(f"Added path '{tab_name}' ({expanded})")
    print("Next: fleet-build   # then fleet-apply")


if __name__ == '__main__':
    main()
