#!/usr/bin/env python3
"""
fleet-set-font: Change the font for the fleet's iTerm2 profile, then rebuild
and reopen the arrangement.

Usage: fleet-set-font <size> [family]

This edits the live iTerm2 profile named in fleet.yaml's iterm2.profile
(global to that profile, not scoped to fleet panes — same profile you'd
edit by hand in iTerm2 > Settings > Profiles > Text).
"""
import sys
import os
import subprocess

import _fleet_yaml
import _fleet_iterm


def main():
    if len(sys.argv) < 2:
        print("Usage: fleet-set-font <size> [family]", file=sys.stderr)
        sys.exit(1)
    try:
        size = float(sys.argv[1])
    except ValueError:
        print(f"ERROR: '{sys.argv[1]}' isn't a valid font size", file=sys.stderr)
        sys.exit(1)
    family = sys.argv[2] if len(sys.argv) > 2 else None

    try:
        cfg = _fleet_yaml.load()
    except FileNotFoundError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        new_font = _fleet_iterm.set_profile_font(cfg['profile'], size, family)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"Set '{cfg['profile']}' profile font to {new_font}")
    script_dir = os.path.dirname(os.path.abspath(__file__))
    subprocess.run([os.path.join(script_dir, 'fleet-apply')], check=True)


if __name__ == '__main__':
    main()
