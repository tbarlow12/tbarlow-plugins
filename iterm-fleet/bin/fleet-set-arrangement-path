#!/usr/bin/env python3
"""
fleet-set-arrangement-path: Change where the .iterm2arrangement file gets
written, then rebuild and reopen.

Usage: fleet-set-arrangement-path <path>
"""
import sys
import os
import subprocess

import _fleet_yaml


def main():
    if len(sys.argv) < 2:
        print("Usage: fleet-set-arrangement-path <path>", file=sys.stderr)
        sys.exit(1)
    new_path = os.path.expanduser(sys.argv[1])
    if not new_path.endswith('.iterm2arrangement'):
        print(f"NOTE: '{new_path}' doesn't end in .iterm2arrangement — that's the "
              f"extension iTerm2 registers a handler for; without it, double-clicking "
              f"the file (or fleet-open) may not find an app to open it with.")

    try:
        cfg = _fleet_yaml.load()
    except FileNotFoundError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    old_path = cfg['arrangement_path']
    cfg['arrangement_path'] = new_path
    _fleet_yaml.save(cfg)
    print(f"Set arrangement_path to {new_path} (was {old_path})")
    print("Note: the old file was left in place — remove it manually if you don't need it.")

    script_dir = os.path.dirname(os.path.abspath(__file__))
    subprocess.run([os.path.join(script_dir, 'fleet-apply')], check=True)


if __name__ == '__main__':
    main()
