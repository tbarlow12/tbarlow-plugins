#!/usr/bin/env bash
# Interactive setup: collects repos, agent count, base dir → writes fleet.yaml
# Usage: fleet-init [--output path/to/fleet.yaml]
set -euo pipefail

OUTPUT="${1:-$HOME/.config/iterm-fleet/fleet.yaml}"

# Allow override via --output flag
if [ "${1:-}" = "--output" ]; then
  OUTPUT="${2:?--output requires a path}"
fi

mkdir -p "$(dirname "$OUTPUT")"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== iterm-fleet setup ==="
echo ""

# Base directory
DEFAULT_BASE="$HOME/repos"
printf "Base directory for agent clones [%s]: " "$DEFAULT_BASE"
read -r BASE_DIR
BASE_DIR="${BASE_DIR:-$DEFAULT_BASE}"
BASE_DIR="${BASE_DIR/#\~/$HOME}"

# Agent count
printf "Number of agents (default 6): "
read -r AGENT_COUNT
AGENT_COUNT="${AGENT_COUNT:-6}"
if ! [[ "$AGENT_COUNT" =~ ^[1-9][0-9]*$ ]]; then
  echo "ERROR: agent count must be a positive integer" >&2
  exit 1
fi

# Repos — try the gh-backed picker (checkbox via fzf if installed, else a
# paginated numbered menu), falling back to manual URL paste if gh isn't
# available/authenticated or nothing gets picked.
REPOS=()
PICKER="$SCRIPT_DIR/_fleet_repo_picker.py"
if [ -x "$PICKER" ] && command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  echo ""
  echo "Fetching repos you have access to via gh (most recently updated first)..."
  while IFS= read -r url; do
    [ -z "$url" ] && continue
    REPOS+=("$url")
  done < <("$PICKER" || true)
fi

if [ ${#REPOS[@]} -eq 0 ]; then
  echo ""
  echo "Paste repo clone URLs (one per line, empty line to finish):"
  while true; do
    printf "  repo URL: "
    read -r url
    [ -z "$url" ] && break
    REPOS+=("$url")
  done
fi

if [ ${#REPOS[@]} -eq 0 ]; then
  echo "ERROR: at least one repo is required" >&2
  exit 1
fi

# Non-repo paths (optional)
echo ""
echo "Optional: add non-repo paths as tabs (e.g. ~/Documents/Notes)."
echo "Each path gets its own tab — all panes open the same directory."
echo "Paste paths one per line, empty line to skip/finish:"
EXTRA_PATHS=()
while true; do
  printf "  path: "
  read -r extra_path
  [ -z "$extra_path" ] && break
  expanded="${extra_path/#\~/$HOME}"
  if [ ! -d "$expanded" ]; then
    echo "  WARNING: '$expanded' is not an existing directory — skipping"
    continue
  fi
  EXTRA_PATHS+=("$extra_path")
done

# Screen resolution
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1056
printf "Screen width [%s]: " "$DEFAULT_WIDTH"
read -r WIDTH
WIDTH="${WIDTH:-$DEFAULT_WIDTH}"
printf "Screen height [%s]: " "$DEFAULT_HEIGHT"
read -r HEIGHT
HEIGHT="${HEIGHT:-$DEFAULT_HEIGHT}"

# Layout
echo ""
echo "Layout options:"
echo "  3x2  — 3 columns, 2 rows (6 panes) [default]"
echo "  2x2  — 2 columns, 2 rows (4 panes)"
echo "  2x3  — 2 columns, 3 rows (6 panes)"
printf "Layout [3x2]: "
read -r LAYOUT
LAYOUT="${LAYOUT:-3x2}"
case "$LAYOUT" in
  3x2) COLS=3; ROWS=2 ;;
  2x2) COLS=2; ROWS=2 ;;
  2x3) COLS=2; ROWS=3 ;;
  *) echo "ERROR: unrecognised layout '$LAYOUT' (use 3x2, 2x2, or 2x3)" >&2; exit 1 ;;
esac

# iTerm2 profile name to clone session metadata from
DEFAULT_PROFILE="Default"
printf "iTerm2 profile name to use [%s]: " "$DEFAULT_PROFILE"
read -r PROFILE
PROFILE="${PROFILE:-$DEFAULT_PROFILE}"

# Arrangement output path
DEFAULT_ARR="$HOME/Library/Application Support/iTerm2/Arrangements/fleet.iterm2arrangement"
printf "Arrangement output path [%s]: " "$DEFAULT_ARR"
read -r ARR_PATH
ARR_PATH="${ARR_PATH:-$DEFAULT_ARR}"
ARR_PATH="${ARR_PATH/#\~/$HOME}"

# Write fleet.yaml
cat > "$OUTPUT" <<YAML
# iterm-fleet configuration
# Generated by fleet-init on $(date -u +%Y-%m-%dT%H:%M:%SZ)

base_dir: $BASE_DIR
agent_count: $AGENT_COUNT
cols: $COLS
rows: $ROWS
screen:
  width: $WIDTH
  height: $HEIGHT
iterm2:
  profile: $PROFILE
  arrangement_path: "$ARR_PATH"
repos:
YAML

for url in "${REPOS[@]}"; do
  echo "  - $url" >> "$OUTPUT"
done

if [ ${#EXTRA_PATHS[@]} -gt 0 ]; then
  echo "paths:" >> "$OUTPUT"
  for p in "${EXTRA_PATHS[@]}"; do
    echo "  - $p" >> "$OUTPUT"
  done
fi

echo ""
echo "Written to $OUTPUT"
echo ""
echo "Next steps:"
echo "  fleet-clone $OUTPUT    # clone repos into agent directories"
echo "  fleet-build $OUTPUT    # generate the iTerm2 arrangement"
echo "  fleet-open  $OUTPUT    # open the arrangement in iTerm2"
